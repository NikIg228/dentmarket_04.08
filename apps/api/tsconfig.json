{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/dist", "../../apps/*/.next", "../../outputs", "../../output", "../../.tmp", "../../.turbo"]
  }
}
