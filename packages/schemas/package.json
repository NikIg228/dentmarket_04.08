{
  "name": "@marketplace/schemas",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./deployment-policy": { "types": "./dist/deployment-policy.d.ts", "default": "./dist/deployment-policy.js" },
    "./workspace-session": { "types": "./dist/workspace-session.d.ts", "default": "./dist/workspace-session.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "zod": "^4.1.12" },
  "devDependencies": { "vitest": "^3.2.4" }
}
