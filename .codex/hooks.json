{
  "description": "Read-only event adapter. SessionStart compact restores the checkpoint and continues the same task; rollover is deferred until full DoD and verified handoff prerequisites. Exact hooks require user review/trust; no direct task, file, Git or network writes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/continuity-hook.cjs\"",
            "commandWindows": "node \"C:\\Users\\user\\Desktop\\dentmarket-kz-main\\.codex\\continuity-hook.cjs\"",
            "timeout": 5,
            "additionalContextLimit": 5000,
            "statusMessage": "Restore checkpoint / continue current task to full DoD"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/continuity-hook.cjs\"",
            "commandWindows": "node \"C:\\Users\\user\\Desktop\\dentmarket-kz-main\\.codex\\continuity-hook.cjs\"",
            "timeout": 5,
            "additionalContextLimit": 5000,
            "statusMessage": "Restore checkpoint / continue current task to full DoD"
          }
        ]
      }
    ]
  }
}
