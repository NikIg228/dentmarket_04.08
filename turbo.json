{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DEPLOYMENT_PROFILE", "NEXT_PUBLIC_DEPLOYMENT_PROFILE"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "transit": { "dependsOn": ["^transit"] },
    "test": { "dependsOn": ["^transit", "@marketplace/schemas#build"], "outputs": ["coverage/**"] },
    "typecheck": { "dependsOn": ["^transit", "@marketplace/schemas#build"] }
  }
}
